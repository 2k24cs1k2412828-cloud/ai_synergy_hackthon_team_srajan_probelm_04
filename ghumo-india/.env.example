# ─────────────────────────────────────────────────────────────────────────────
#  Ghumo India (Beyond the Fort) — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file with real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key
# Required for live cloud AI conversational features.
# If omitted or invalid, the app gracefully falls back to the built-in offline
# knowledge engine (50 MP heritage destinations, itineraries, crowd advisories).
#
# IMPORTANT SECURITY & ROTATION NOTICE:
# 1. Obtain your key from: https://aistudio.google.com/app/apikey
# 2. If a key is ever exposed in client code or build artifacts, ROTATE IT IMMEDIATELY
#    in Google AI Studio by deleting the old key and generating a new one.
# 3. For production hosting (Vercel/Node), set GEMINI_API_KEY as an encrypted
#    environment variable in the hosting dashboard.
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Canonical Production URL (used for SEO, Open Graph and Sitemap)
VITE_CANONICAL_URL=https://d360.edufutura.in
